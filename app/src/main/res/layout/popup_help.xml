<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_help_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:text="How to Use Zenny"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Home Page Section -->
        <TextView
            style="@style/TextAppearance.AppCompat.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Home Page: Habits"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/add_habit_tap_the_button_at_the_bottom_to_create_a_new_habit_edit_delete_habit_long_press_on_any_habit_in_the_list_to_open_the_options_menu_where_you_can_edit_or_delete_it" />

        <!-- Mood Page Section -->
        <TextView
            style="@style/TextAppearance.AppCompat.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/mood_page_analysis"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/add_mood_use_the_bottom_sheet_to_add_your_mood_for_the_day_monthly_analysis_the_calendar_on_the_mood_page_shows_your_mood_for_each_day_tap_on_a_day_to_see_details_the_chart_below_shows_a_summary_of_your_moods_over_the_current_month" />

        <!-- Hydration Section -->
        <TextView
            style="@style/TextAppearance.AppCompat.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/hydration_"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/set_glass_size_go_to_the_hydration_tab_and_tap_on_the_settings_icon_to_set_your_preferred_glass_size_set_hours_amp_reminder_in_the_same_settings_menu_you_can_define_your_drinking_hours_and_enable_reminders_to_stay_hydrated_throughout_the_day" />

        <Button
            android:id="@+id/btn_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/close" />

    </LinearLayout>
</ScrollView>
